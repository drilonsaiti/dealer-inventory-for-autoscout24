<?php
/**
 * Local WordPress PHPUnit configuration template.
 *
 * Copy this file to wp-tests-config.php and set the required environment
 * variables before running Composer's test script. Use a disposable test
 * database: the WordPress test suite resets its tables.
 *
 * @package DealerInventory
 */

$dinv_test_config = array(
	'WP_TESTS_WORDPRESS_PATH' => getenv( 'WP_TESTS_WORDPRESS_PATH' ),
	'DINV_TEST_DB_NAME'       => getenv( 'DINV_TEST_DB_NAME' ),
	'DINV_TEST_DB_USER'       => getenv( 'DINV_TEST_DB_USER' ),
	'DINV_TEST_DB_PASSWORD'   => getenv( 'DINV_TEST_DB_PASSWORD' ),
	'DINV_TEST_DB_HOST'       => getenv( 'DINV_TEST_DB_HOST' ),
);

// XAMPP commonly runs its local root account without a password.
if ( false === $dinv_test_config['DINV_TEST_DB_PASSWORD'] ) {
	$dinv_test_config['DINV_TEST_DB_PASSWORD'] = '';
}

foreach ( $dinv_test_config as $dinv_name => $dinv_value ) {
	if ( false === $dinv_value || ( 'DINV_TEST_DB_PASSWORD' !== $dinv_name && '' === $dinv_value ) ) {
		throw new RuntimeException( 'Set ' . $dinv_name . ' before running the WordPress PHPUnit suite.' );
	}
}

define( 'ABSPATH', rtrim( $dinv_test_config['WP_TESTS_WORDPRESS_PATH'], '/\\' ) . DIRECTORY_SEPARATOR );
define( 'WP_DEFAULT_THEME', 'default' );
define( 'WP_DEBUG', true );
define( 'DB_NAME', $dinv_test_config['DINV_TEST_DB_NAME'] );
define( 'DB_USER', $dinv_test_config['DINV_TEST_DB_USER'] );
define( 'DB_PASSWORD', $dinv_test_config['DINV_TEST_DB_PASSWORD'] );
define( 'DB_HOST', $dinv_test_config['DINV_TEST_DB_HOST'] );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

$table_prefix = 'wptests_';

define( 'WP_TESTS_DOMAIN', 'example.org' );
define( 'WP_TESTS_EMAIL', 'admin@example.org' );
define( 'WP_TESTS_TITLE', 'Dealer Inventory PHPUnit Tests' );
define( 'WP_PHP_BINARY', escapeshellarg( PHP_BINARY ) );
